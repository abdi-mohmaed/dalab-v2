{
  "name": "dalab-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "dalab_web",
    "dalab_mobile",
    "packages/*"
  ],
  "scripts": {
    "web": "yarn workspace dalab run dev",
    "mobile": "yarn workspace dalab-mobile start",
    "shared": "yarn workspace @dalab/shared build",
    "install:all": "yarn install",
    "clean": "yarn workspaces foreach -A run clean"
  },
  "devDependencies": {
    "connect": "^3.7.0"
  },
  "resolutions": {
    "react": "18.3.1",
    "react-native": "0.76.0"
  },
  "packageManager": "yarn@3.6.4"
}
